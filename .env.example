# Copy to .env and fill in. Never commit .env.

# LLM backend: mock | openai
LLM_MODE=mock

# Required only when LLM_MODE=openai
OPENAI_API_KEY=

# Optional: OpenAI chat model with structured output support (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: enrich cards with ARASAAC pictograms (external requests); set to false offline
PICTOGRAMS_ENABLED=true
